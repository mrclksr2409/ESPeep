# Copy this file to `secrets.yaml` and fill in your own values.
# `secrets.yaml` is git-ignored on purpose — never commit real credentials.

wifi_ssid: "MyWiFi"
wifi_password: "super-secret-wifi-password"

# Fallback access point that ESPeep opens when it cannot join your WiFi.
ap_password: "espeep-setup"

# Pre-shared key for the Home Assistant API connection.
# Generate one with:  openssl rand -base64 32
api_encryption_key: "REPLACE_ME_WITH_A_BASE64_32_BYTE_KEY"

# Password for over-the-air firmware updates.
ota_password: "another-secret"
